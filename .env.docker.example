# Template .env untuk deploy Docker.
#
# Salin ke .env di server, edit yang bertanda "<<<" lalu jalankan init-build.sh.
# Compose juga membaca file ini untuk interpolasi: COMPOSE_PROJECT_NAME + TRAEFIK_HOST
# dipakai di label Traefik, container_name, dan nama Traefik service.

# --- Compose / Traefik --------------------------------------------------
COMPOSE_PROJECT_NAME=dias-erp
TRAEFIK_HOST=erp.example.com

# --- App --------------------------------------------------------------
APP_NAME="DIAS ERP"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://${TRAEFIK_HOST}

# Generate: php artisan key:generate --show (init-build.sh otomatis kalau kosong)
APP_KEY=

# LOG ke stderr -> `docker logs` (lihat entrypoint.sh & supervisord.conf).
LOG_CHANNEL=stderr

# --- Database (shared dgn CI3/CI4, JANGAN dibuat ulang) ----------------
# MariaDB host = NAMA SERVICE di network `mariadb-net`, BUKAN localhost.
DB_CONNECTION=mariadb
DB_HOST=<<nama_service_mariadb_di_mariadb_net>>
DB_PORT=3306
DB_DATABASE=data_pos_nmw_2023
DB_USERNAME=root
DB_PASSWORD=


# --- Session / cache / queue (aturan anti-tabrakan CLAUDE.md) ----------
# Pakai file -> folder storage harus persisten (volume di docker-compose.yaml).
SESSION_DRIVER=file
SESSION_LIFETIME=120

CACHE_STORE=file
QUEUE_CONNECTION=sync

FILESYSTEM_DISK=local

# --- Misc default -----------------------------------------------------
BCRYPT_ROUNDS=12

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID